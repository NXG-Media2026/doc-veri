---
import type { Locale } from '../data/site';
interface Props {
  title: string; items: { icon: string; title: string; description: string }[]; locale?: Locale;
}
const { title, items, locale = 'de' } = Astro.props;
---
<section class="home-approach editorial-section">
  <div class="editorial-shell home-approach__grid">
    <div>
      <p class="eyebrow">{title}</p>
      <h2 class="section-heading">{locale === 'en' ? 'Science, made personal.' : 'Wissenschaft, die dich versteht.'}</h2>
      <p class="home-approach__note">{locale === 'en' ? 'Hormones. Training. Nutrition. Your cycle.' : 'Hormone. Training. Ernährung. Dein Zyklus.'}</p>
    </div>
    <ol class="home-principles">
      {items.map((item, index) => (
        <li>
          <span class="eyebrow" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div><h3>{item.title}</h3><p>{item.description}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>
