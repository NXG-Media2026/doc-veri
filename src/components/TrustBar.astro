---
import type { Locale } from '../data/site';
interface Props { items: { value: string; label: string }[]; locale?: Locale; }
const { items, locale = 'de' } = Astro.props;
---
<section class="home-trust editorial-shell" aria-label={locale === 'en' ? 'About doc.veri' : 'Über doc.veri'}>
  <ul>{items.map(item => <li><span>{item.value}</span><span>{item.label}</span></li>)}</ul>
</section>
