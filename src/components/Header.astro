---
import { navigation } from '../data/navigation';
import { siteConfig, type Locale } from '../data/site';
import { t, localizePath, getTranslatedPath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
interface Props { locale?: Locale; currentPath?: string; hreflang?: Array<{ lang: string; href: string }>; }
const { locale = 'de', currentPath = '/', hreflang } = Astro.props;
const en = locale === 'en';
const offers = navigation[locale].find(item => item.children)!;
const navItems = [
  { label: en ? 'About Verena' : 'Über Verena', href: getTranslatedPath('/ueber', locale) },
  { label: en ? 'Explore' : 'Wissen', href: getTranslatedPath('/themen', locale), children: [
    { label: en ? 'All topics' : 'Alle Themen', href: getTranslatedPath('/themen', locale) },
    { label: 'Blog', href: getTranslatedPath('/blog', locale) },
    { label: 'Masterclass', href: en ? '/en/masterclass/hormones-histamine-cycle-superpower' : '/masterclass/hormone-histamin-zyklus-superpower' },
    { label: en ? 'Free quiz' : 'Kostenloses Quiz', href: getTranslatedPath('/quiz', locale) },
    { label: 'FAQ', href: getTranslatedPath('/faq', locale) },
  ] },
  offers,
  { label: en ? 'Contact' : 'Kontakt', href: getTranslatedPath('/kontakt', locale) },
];
const normalizedPath = currentPath.replace(/\/$/, '') || '/';
const active = (href: string) => normalizedPath === href || normalizedPath.startsWith(href + '/');
---
<header class="site-header">
  <div class="editorial-shell site-header__bar">
    <a href={localizePath('/', locale)} class="site-wordmark" aria-label={en ? 'doc.veri home' : 'doc.veri Startseite'}>{siteConfig.name}</a>
    <nav class="desktop-nav" aria-label={en ? 'Main navigation' : 'Hauptnavigation'}>
      {navItems.map(item => item.children ? (
        <details class="nav-disclosure">
          <summary class:list={[active(item.href) && 'is-active']}>{item.label}<span aria-hidden="true">⌄</span></summary>
          <ul>
            {item === offers && <li><a href={item.href}>{en ? 'All offers' : 'Alle Angebote'}</a></li>}
            {item.children.map(child => <li><a href={child.href} aria-current={normalizedPath === child.href ? 'page' : undefined}>{child.label}</a></li>)}
          </ul>
        </details>
      ) : <a href={item.href} aria-current={normalizedPath === item.href ? 'page' : undefined}>{item.label}</a>)}
      {siteConfig.languageSwitcherEnabled && hreflang?.length && <LanguageSwitcher locale={locale} currentPath={currentPath} hreflang={hreflang} />}
      <a class="editorial-button header-cta" href={getTranslatedPath('/angebot', locale)}>{t('cta.discover', locale)}<span aria-hidden="true">↗</span></a>
    </nav>
    <button id="menu-btn" class="menu-toggle" aria-label={t('general.menu', locale)} aria-expanded="false" aria-controls="mobile-nav">
      <span>{en ? 'Menu' : 'Menü'}</span><span class="menu-toggle__mark" aria-hidden="true">+</span>
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label={en ? 'Mobile navigation' : 'Mobile Navigation'} hidden>
    <div class="editorial-shell">
      {navItems.map(item => item.children ? (
        <details>
          <summary>{item.label}<span aria-hidden="true">+</span></summary>
          <ul>
            {item === offers && <li><a href={item.href}>{en ? 'All offers' : 'Alle Angebote'}</a></li>}
            {item.children.map(child => <li><a href={child.href} aria-current={normalizedPath === child.href ? 'page' : undefined}>{child.label}</a></li>)}
          </ul>
        </details>
      ) : <a href={item.href} aria-current={normalizedPath === item.href ? 'page' : undefined}>{item.label}</a>)}
      {siteConfig.languageSwitcherEnabled && hreflang?.length && <div class="mobile-languages"><LanguageSwitcher locale={locale} currentPath={currentPath} hreflang={hreflang} /></div>}
      <a class="editorial-button" href={getTranslatedPath('/angebot', locale)}>{t('cta.discover', locale)}<span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .site-header__bar { height: 5.5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .site-wordmark { font-family: 'Playfair Display', Georgia, serif; font-size: 2.15rem; letter-spacing: -.06em; color: var(--color-primary-dark); padding-block: .4rem; }
  .desktop-nav { display: flex; gap: 1.8rem; align-items: center; font-size: .8125rem; }
  .desktop-nav > a:not(.header-cta), .nav-disclosure summary { padding-block: .9rem; }
  .desktop-nav a[aria-current], .is-active { text-decoration: underline; text-underline-offset: .4rem; }
  .nav-disclosure { position: relative; }
  .nav-disclosure summary { display: flex; gap: .5rem; list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .nav-disclosure ul { position: absolute; top: 100%; left: -1.25rem; min-width: 14rem; padding: .7rem; border: 1px solid var(--color-border); background: var(--color-bg-alt); }
  .nav-disclosure ul a { display: block; padding: .8rem; min-height: 44px; }
  .nav-disclosure ul a:hover { background: var(--color-accent-light); }
  .header-cta { min-height: 2.8rem; padding: .6rem 1rem; gap: 1rem; font-size: .75rem; }
  .menu-toggle { display: none; align-items: center; gap: 1rem; min-height: 44px; padding: .5rem; font-size: .8125rem; }
  .menu-toggle__mark { font-size: 1.8rem; line-height: 1; }
  .menu-toggle[aria-expanded="true"] .menu-toggle__mark { transform: rotate(45deg); }
  .mobile-nav { max-height: calc(100dvh - 5.5rem); overflow-y: auto; overscroll-behavior: contain; padding-block: 1rem 2rem; border-top: 1px solid var(--color-border); }
  .mobile-nav[hidden] { display: none; }
  .mobile-nav .editorial-shell > a:not(.editorial-button), .mobile-nav summary { display: flex; justify-content: space-between; padding-block: 1rem; border-bottom: 1px solid var(--color-border); min-height: 44px; font-family: 'Playfair Display', Georgia, serif; font-size: 1.6rem; list-style: none; cursor: pointer; }
  .mobile-nav ul { padding-block: .5rem; }
  .mobile-nav li a { display: block; padding: .8rem 1rem; min-height: 44px; }
  .mobile-languages { margin-block: 1rem; }
  .mobile-nav .editorial-button { margin-top: 1rem; }
  @media (max-width: 1099px) { .desktop-nav { display: none; } .menu-toggle { display: inline-flex; } }
  @media (min-width: 1100px) { .mobile-nav { display: none; } }
  @media (max-width: 599px) { .site-header__bar { height: 4.5rem; } .mobile-nav { max-height: calc(100dvh - 4.5rem); } }
</style>
<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  if (btn && nav) {
    const closeMenu = () => { nav.hidden = true; btn.setAttribute('aria-expanded', 'false'); };
    btn.addEventListener('click', () => {
      const opening = nav.hidden;
      nav.hidden = !opening;
      btn.setAttribute('aria-expanded', String(opening));
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !nav.hidden) { closeMenu(); btn.focus(); }
    });
    nav.addEventListener('click', event => {
      if ((event.target as Element).closest('a')) closeMenu();
    });
    window.matchMedia('(min-width: 1100px)').addEventListener('change', event => {
      if (event.matches) closeMenu();
    });
  }
  const disclosures = document.querySelectorAll<HTMLDetailsElement>('.nav-disclosure');
  disclosures.forEach(disclosure => {
    disclosure.addEventListener('toggle', () => {
      if (disclosure.open) disclosures.forEach(other => { if (other !== disclosure) other.open = false; });
    });
    disclosure.addEventListener('keydown', event => {
      if (event.key === 'Escape') { disclosure.open = false; disclosure.querySelector('summary')?.focus(); }
    });
    disclosure.addEventListener('focusout', event => {
      if (!disclosure.contains(event.relatedTarget as Node)) disclosure.open = false;
    });
  });
  document.addEventListener('click', event => {
    disclosures.forEach(disclosure => { if (!disclosure.contains(event.target as Node)) disclosure.open = false; });
  });
</script>
