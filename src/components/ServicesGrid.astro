---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { PageType, EventName } from '../lib/analytics';
import { trackOnClick } from '../lib/analytics';
import { t } from '../i18n/utils';
import type { Locale } from '../data/site';
interface ServiceItem {
  title: string; slug: string; href?: string; excerpt: string;
  image?: ImageMetadata | string; imageAlt?: string;
  coverImages?: { src: ImageMetadata; alt: string }[];
}
interface Props {
  title: string; subtitle?: string; services: ServiceItem[]; basePath?: string;
  locale?: Locale; pageType?: PageType; pageSlug?: string; eventName?: EventName;
  viewAllHref?: string; viewAllLabel?: string;
}
const { title, subtitle, services, basePath = '', locale = 'de', pageType = 'homepage',
  pageSlug = '/', eventName = 'product_cta_click', viewAllHref, viewAllLabel } = Astro.props;
---
<section class="home-offers editorial-section editorial-shell">
  <div class="editorial-section-head">
    <div><p class="eyebrow">{locale === 'en' ? 'Your next step' : 'Dein nächster Schritt'}</p><h2 class="section-heading">{title}</h2></div>
    {subtitle && <p>{subtitle}</p>}
  </div>
  <div class="home-offers__grid">
    {services.map((service, index) => (
      <a class="home-offer" href={service.href ?? (basePath ? `${basePath}/${service.slug}` : `/${service.slug}`)}
        onclick={trackOnClick(eventName, { page_type: pageType, page_slug: pageSlug, locale, cta_location: 'inline' })}>
        <div class:list={['home-offer__image', service.coverImages?.length && 'home-offer__covers']}>
          {service.coverImages?.length ? service.coverImages.map(cover => (
            <Image src={cover.src} alt={cover.alt} width={320} loading="lazy" />
          )) : service.image && (
            typeof service.image === 'string' ? (
              <img src={service.image} alt={service.imageAlt ?? service.title} width="700" height="850" loading="lazy" />
            ) : (
              <Image src={service.image} alt={service.imageAlt ?? service.title} widths={[400, 700, 1000]}
                sizes="(min-width: 900px) 40vw, 100vw" loading="lazy" />
            )
          )}
        </div>
        <div class="home-offer__heading"><h3>{service.title}</h3><span class="eyebrow" aria-hidden="true">0{index + 1} / ↗</span></div>
        <p>{service.excerpt}</p>
        <span class="editorial-link">{t('cta.learnMore', locale)}<span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
  {viewAllHref && viewAllLabel && <a class="editorial-link home-offers__all" href={viewAllHref}>{viewAllLabel}<span aria-hidden="true">→</span></a>}
</section>
