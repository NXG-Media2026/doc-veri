---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteConfig, type Locale } from '../data/site';
import { getTranslatedPath } from '../i18n/utils';
interface Props { locale?: Locale; image?: ImageMetadata; role?: string; bio?: string; qualifications?: string[]; }
const { locale = 'de', image, role, bio, qualifications } = Astro.props;
const { founder } = siteConfig;
const displayRole = role ?? founder.role;
---
<section class="home-founder editorial-section editorial-shell">
  <figure class="home-founder__portrait">
    {image ? (
      <Image src={image} alt={locale === 'en' ? 'Dr. Verena Mann at an Ironman finish line' : 'Dr. Verena Mann im Ironman-Ziel'} widths={[400, 640, 900]} sizes="(min-width: 900px) 38vw, 100vw" loading="lazy" />
    ) : founder.image && (
      <img src={founder.image} alt={founder.name} width="640" height="800" loading="lazy" />
    )}
    <figcaption class="eyebrow">doc.veri / {locale === 'en' ? 'Meet the founder' : 'Die Frau dahinter'}</figcaption>
  </figure>
  <div class="home-founder__copy">
    <p class="eyebrow">{locale === 'en' ? 'Hi, I’m Verena.' : 'Hi, ich bin Verena.'}</p>
    <h2 class="section-heading">{displayRole}</h2>
    <p class="home-founder__bio">{bio ?? founder.bio}</p>
    <ul class="home-founder__credentials">
      {(qualifications ?? founder.qualifications).map(item => <li>{item}</li>)}
    </ul>
    <a class="editorial-link" href={getTranslatedPath('/ueber', locale)}>
      {locale === 'en' ? 'More about Dr. Verena Mann' : 'Mehr über Dr. Verena Mann'}<span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
