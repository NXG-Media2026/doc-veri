---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { EventName, PageType } from '../lib/analytics';
import { trackOnClick } from '../lib/analytics';
import { siteConfig, type Locale } from '../data/site';
interface Props {
  title: string; subtitle: string; ctaText: string; ctaHref: string;
  secondaryCtaText?: string; secondaryCtaHref?: string;
  backgroundImage?: ImageMetadata | string; backgroundAlt?: string;
  locale?: Locale; pageType?: PageType; pageSlug?: string; eventName?: EventName;
}
const { title, subtitle, ctaText, ctaHref, secondaryCtaText, secondaryCtaHref,
  backgroundImage, backgroundAlt = '', locale = 'de', pageType = 'homepage',
  pageSlug = '/', eventName = 'product_cta_click' } = Astro.props;
const split = title.indexOf('. ');
const lead = split < 0 ? title : title.slice(0, split + 1);
const continuation = split < 0 ? '' : title.slice(split + 2);
---
<section class="home-hero editorial-shell">
  <div class="home-hero__copy">
    <p class="eyebrow">{locale === 'en' ? 'Medicine. Movement. You.' : 'Medizin. Bewegung. Du.'}</p>
    <h1 class="display-heading">{lead} <span>{continuation}</span></h1>
    <p class="home-hero__intro">{subtitle}</p>
    <div class="editorial-actions">
      <a href={ctaHref} class="editorial-button"
        onclick={trackOnClick(eventName, { page_type: pageType, page_slug: pageSlug, locale, cta_location: 'hero' })}>
        {ctaText}<span aria-hidden="true">↗</span>
      </a>
      {secondaryCtaText && secondaryCtaHref && (
        <a href={secondaryCtaHref} class="editorial-link">{secondaryCtaText}<span aria-hidden="true">→</span></a>
      )}
    </div>
  </div>
  {backgroundImage && (
    <figure class="home-hero__portrait">
      {typeof backgroundImage === 'string' ? (
        <img src={backgroundImage} alt={backgroundAlt} width="900" height="1200" loading="eager" fetchpriority="high" />
      ) : (
        <Image src={backgroundImage} alt={backgroundAlt} widths={[480, 720, 1000]}
          sizes="(min-width: 900px) 46vw, 100vw" loading="eager" fetchpriority="high" />
      )}
      <figcaption>
        <span class="home-hero__name">{siteConfig.founder.name}</span>
        <span>{locale === 'en' ? 'Physician & endurance athlete' : 'Notärztin & Ausdauer-Athletin'}</span>
      </figcaption>
    </figure>
  )}
</section>
